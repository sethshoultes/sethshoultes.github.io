{
  "full": "node --test tests/*.test.mjs && scripts/check-inline-styles.sh && .github/ci/site-check.sh",
  "ignore": [
    "docs/**",
    "README.md",
    "CLAUDE.md",
    ".great-authors/**",
    ".great-minds/**",
    "data/**",
    "images.json",
    "netlify.toml",
    ".gitignore"
  ],
  "core": [
    ".github/test-map.json",
    ".github/ci/**",
    ".github/workflows/**",
    "Gemfile",
    "Gemfile.lock",
    ".ruby-version",
    "assets/vendor/site-kit/**",
    "kit.json",
    "kit.lock",
    "package.json",
    "package-lock.json",
    "plugins.lock",
    "plugins/**"
  ],
  "deploy": [],
  "areas": {
    "site": {
      "paths": [
        ".well-known/**",
        "404.html",
        "CNAME",
        "_config.yml",
        "_data/**",
        "_includes/**",
        "_layouts/**",
        "_posts/**",
        "_redirects",
        "academy-md.html",
        "academy/**",
        "admin/**",
        "advanced-typing-games/**",
        "ai-readiness-md.html",
        "ai-readiness/**",
        "ai-search-optimization-md.html",
        "ai-search-optimization/**",
        "ai-services-md.html",
        "ai-services/**",
        "animation-artwork-video-md.html",
        "animation-artwork-video/**",
        "apps-md.html",
        "apps/**",
        "arcade/**",
        "ask-md.html",
        "ask/**",
        "assets/**",
        "blog/**",
        "build/**",
        "case-studies/**",
        "cedar-city-utah-md.html",
        "cedar-city-utah/**",
        "claude-academy/**",
        "consulting/**",
        "coral-canyon-utah-md.html",
        "coral-canyon-utah/**",
        "field-service-software-md.html",
        "field-service-software/**",
        "game-center/**",
        "garage-door-science-hub/**",
        "google-ads-md.html",
        "google-ads/**",
        "html5/**",
        "hurricane-utah-md.html",
        "hurricane-utah/**",
        "index.html",
        "ivins-santa-clara-utah-md.html",
        "ivins-santa-clara-utah/**",
        "kit.json",
        "kit.lock",
        "lab/**",
        "learn-ai-md.html",
        "learn-ai/**",
        "library-md.html",
        "library/**",
        "little-valley-st-george-utah-md.html",
        "little-valley-st-george-utah/**",
        "llms-full.txt",
        "llms.txt",
        "meals-md.html",
        "meals/**",
        "meetup/**",
        "murder-on-the-arizona-strip-book.md",
        "ops/**",
        "preview/**",
        "privacy.md",
        "projects-md.html",
        "projects/**",
        "recipes-md.html",
        "recipes/**",
        "robots.txt",
        "seo-services-md.html",
        "seo-services/**",
        "services-md.html",
        "services/**",
        "sitemap.xml",
        "skills/**",
        "southern-utah-md.html",
        "southern-utah/**",
        "springdale-utah-md.html",
        "springdale-utah/**",
        "st-george-utah-md.html",
        "st-george-utah/**",
        "talk-md.html",
        "talk/**",
        "terms.md",
        "tools/**",
        "typing-games/**",
        "washington-city-utah-md.html",
        "washington-city-utah/**",
        "web-development-md.html",
        "web-development/**",
        "wordpress-development-md.html",
        "wordpress-development/**",
        "wordpress-plugins/**",
        "scripts/academy/**",
        "_headers",
        "functions/**",
        "how-this-site-is-built.md"
      ],
      "run": ".github/ci/site-check.sh"
    },
    "workers": {
      "paths": [
        "workers/**",
        "tests/tools-server.test.mjs",
        "tests/ask-server.test.mjs",
        "tests/news-server.test.mjs"
      ],
      "run": "node --test tests/tools-server.test.mjs tests/ask-server.test.mjs tests/news-server.test.mjs"
    },
    "checks": {
      "paths": [
        "scripts/check-*.mjs",
        "scripts/check-*.sh",
        "tests/check-*.test.mjs",
        "tests/README.md"
      ],
      "run": "node --test tests/check-links.test.mjs tests/check-youtube.test.mjs && scripts/check-inline-styles.sh"
    },
    "scripts": {
      "paths": [
        "scripts/**",
        "tests/README.md"
      ],
      "run": "python3 -m py_compile $(git ls-files 'scripts/*.py') && for f in scripts/*.mjs; do node --check \"$f\"; done"
    },
    "brain": {
      "paths": [
        "SOUL.md",
        "canon/**",
        ".agent/**",
        ".sitekit/**"
      ],
      "run": "python3 -I .sitekit/site_check.py --brain --root ."
    },
    "meals": {
      "paths": [
        "assets/meals.js",
        "_data/meals.yml",
        "tests/meals.test.mjs"
      ],
      "run": "node --test tests/meals.test.mjs"
    }
  }
}
