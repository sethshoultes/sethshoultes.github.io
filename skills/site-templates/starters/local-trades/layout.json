{
  "template": "local-trades",
  "why": "{{placeholder:Who you help and why they call you, in one or two warm sentences: what you fix, where you work, and why people trust you with it}}",
  "pages": [
    {
      "path": "/",
      "type": "home",
      "title": "{{placeholder:Business name}} in {{placeholder:your town}}",
      "description": "{{placeholder:One line: what you do, where, and why people call you}}",
      "sections": [
        {
          "id": "hero",
          "block": "hero@1",
          "props": {
            "heading": "{{placeholder:What you fix}}, fixed {{placeholder:today}}",
            "lead": "{{placeholder:One line on who you help and why they trust you}}",
            "cta": {
              "text": "Call {{placeholder:your phone}}",
              "href": "{{placeholder:tel:+1...}}"
            }
          }
        },
        {
          "id": "services",
          "block": "services@1",
          "props": {
            "heading": "What we do",
            "intro": "{{placeholder:A line on the kinds of jobs you take}}",
            "items": [
              {
                "name": "{{placeholder:Service one}}",
                "text": "{{placeholder:What it is, in a sentence}}"
              },
              {
                "name": "{{placeholder:Service two}}",
                "text": "{{placeholder:What it is, in a sentence}}"
              },
              {
                "name": "{{placeholder:Service three}}",
                "text": "{{placeholder:What it is, in a sentence}}"
              }
            ],
            "more": {
              "text": "All services",
              "href": "/services/"
            }
          }
        },
        {
          "id": "reviews",
          "block": "proof@1",
          "props": {
            "heading": "What customers say",
            "reviews": [
              {
                "quote": "{{placeholder:A real customer's words}}",
                "name": "{{placeholder:Their name, and town}}"
              },
              {
                "quote": "{{placeholder:A real customer's words}}",
                "name": "{{placeholder:Their name, and town}}"
              }
            ]
          }
        },
        {
          "id": "questions",
          "block": "faq@1",
          "props": {
            "heading": "Questions people ask",
            "questions": [
              {
                "q": "{{placeholder:Do you come out the same day?}}",
                "a": "{{placeholder:Your answer}}"
              },
              {
                "q": "{{placeholder:What areas do you cover?}}",
                "a": "{{placeholder:Your towns}}"
              },
              {
                "q": "{{placeholder:How much does a visit cost?}}",
                "a": "{{placeholder:Your answer, in plain numbers}}"
              }
            ]
          }
        },
        {
          "id": "call",
          "block": "cta@1",
          "props": {
            "heading": "Need it fixed?",
            "button": {
              "text": "Get in touch",
              "href": "/contact/#reach"
            }
          }
        }
      ]
    },
    {
      "path": "/services/",
      "type": "service",
      "title": "Services",
      "description": "{{placeholder:One line on the jobs you take, and where}}",
      "sections": [
        {
          "id": "services-hero",
          "block": "hero@1",
          "props": {
            "heading": "{{placeholder:What you fix}}, done properly",
            "lead": "{{placeholder:One line on how you work}}",
            "cta": {
              "text": "Ask for a quote",
              "href": "/contact/#reach"
            }
          }
        },
        {
          "id": "services-list",
          "block": "services@1",
          "props": {
            "heading": "Our services",
            "items": [
              {
                "name": "{{placeholder:Service one}}",
                "text": "{{placeholder:Two or three sentences on it}}"
              },
              {
                "name": "{{placeholder:Service two}}",
                "text": "{{placeholder:Two or three sentences on it}}"
              },
              {
                "name": "{{placeholder:Service three}}",
                "text": "{{placeholder:Two or three sentences on it}}"
              }
            ]
          }
        },
        {
          "id": "services-call",
          "block": "cta@1",
          "props": {
            "heading": "Not sure which you need?",
            "button": {
              "text": "Ask us",
              "href": "/contact/#reach"
            }
          }
        }
      ]
    },
    {
      "path": "/about/",
      "type": "about",
      "title": "About",
      "sections": [
        {
          "id": "about-us",
          "block": "about@1",
          "props": {
            "heading": "Who we are",
            "text": "{{placeholder:Who you are, how long you have done this, and what you care about}}"
          }
        },
        {
          "id": "about-call",
          "block": "cta@1",
          "props": {
            "heading": "Need something fixed?",
            "button": {
              "text": "Get in touch",
              "href": "/contact/#reach"
            }
          }
        }
      ]
    },
    {
      "path": "/contact/",
      "type": "contact",
      "title": "Contact",
      "description": "{{placeholder:How to reach you, and when}}",
      "sections": [
        {
          "id": "reach",
          "block": "contact@1",
          "props": {
            "heading": "Call, email or stop by",
            "address": "{{placeholder:Your address, or the towns you cover}}",
            "hours": "{{placeholder:Your hours}}",
            "reach": [
              {
                "button": {
                  "text": "Call {{placeholder:your phone}}",
                  "href": "{{placeholder:tel:+1...}}"
                }
              },
              {
                "button": {
                  "text": "Email us",
                  "href": "{{placeholder:mailto:you@yourbusiness.com}}"
                }
              }
            ]
          }
        }
      ]
    }
  ]
}
