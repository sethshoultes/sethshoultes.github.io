{
  "name": "services",
  "version": "1.1",
  "title": "Services: what you do, one card each with a line and a link",
  "props": {
    "heading": {
      "type": "text",
      "required": true,
      "max": 90
    },
    "intro": {
      "type": "text",
      "max": 300
    },
    "items": {
      "type": "items",
      "required": true, "max": 12,
      "fields": {
        "name": {
          "type": "text",
          "required": true
        },
        "text": {
          "type": "text"
        },
        "link": {
          "type": "link"
        }
      }
    },
    "more": {
      "type": "link"
    }
  },
  "tree": {
    "part": "group",
    "tag": "section",
    "children": [
      {
        "part": "heading",
        "level": 2,
        "text": "{heading}"
      },
      {
        "part": "paragraph",
        "text": "{intro}"
      },
      {
        "part": "columns",
        "children": [
          {
            "part": "column",
            "each": "items",
            "children": [
              {
                "part": "heading",
                "level": 3,
                "text": "{item.name}"
              },
              {
                "part": "paragraph",
                "text": "{item.text}"
              },
              {
                "part": "buttons",
                "children": [
                  {
                    "part": "button",
                    "text": "{item.link.text}",
                    "href": "{item.link.href}"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "part": "buttons",
        "children": [
          {
            "part": "button",
            "text": "{more.text}",
            "href": "{more.href}"
          }
        ]
      }
    ]
  }
}
