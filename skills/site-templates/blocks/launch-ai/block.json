{
  "name": "launch-ai",
  "version": "1.0",
  "title": "Open Claude or ChatGPT with a request already typed in (site-kit#435)",
  "props": {
    "heading": {"type": "text", "max": 90},
    "intro": {"type": "text", "max": 300},
    "prompt": {"type": "prefill", "required": true, "max": 600}
  },
  "tree": {"part": "group", "tag": "section", "children": [
    {"part": "heading", "level": 2, "text": "{heading}"},
    {"part": "paragraph", "text": "{intro}"},
    {"part": "paragraph", "text": "{prompt.text}"},
    {"part": "buttons", "children": [
      {"part": "button", "text": "Open in Claude", "href": "{prompt.claude}", "newtab": true},
      {"part": "button", "text": "Open in ChatGPT", "href": "{prompt.chatgpt}", "newtab": true}
    ]}
  ]}
}
