{
  "name": "about",
  "version": "1.0",
  "title": "About: who you are, in a few lines beside a picture",
  "props": {
    "heading": {"type": "text", "required": true, "max": 90},
    "text": {"type": "text", "required": true, "max": 1200},
    "image": {"type": "image"}
  },
  "tree": {"part": "group", "tag": "section", "children": [
    {"part": "columns", "children": [
      {"part": "column", "children": [
        {"part": "heading", "level": 2, "text": "{heading}"},
        {"part": "paragraph", "text": "{text}"}
      ]},
      {"part": "column", "children": [{"part": "image", "src": "{image.src}", "alt": "{image.alt}"}]}
    ]}
  ]}
}
